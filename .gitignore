# 设计文档与参考项目（不进版本库）
dev
refer

# 基准数据（tools/seed.py 生成，可达 GB 级）
.bench/

# ── Python ────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── 构建产物 ──────────────────────────────────────────────
build/
dist/
*.spec

# ── 本地运行产生的数据 ────────────────────────────────────
# 便携模式（同级存在 portable.marker）会把这些写在仓库根目录。
# 全部锚定到根目录：不加 / 前缀会连 tests/fixtures/data/ 与
# tests/fixtures/config.json 一起吞掉，而 M5 的迁移测试正需要这类夹具。
/data/
/logs/
/config.json
/portable.marker
/STARTUP_ERROR.txt

# ── 编辑器与操作系统 ──────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 本地环境变量 ──────────────────────────────────────────
.env
.env.local

# ── 本地工具配置 ──────────────────────────────────────────
# 只忽略 .local.json：共享的 .claude/ 配置（如项目级 skills）仍可入库。
.claude/settings.local.json

# ── 打补丁与合并残留 ──────────────────────────────────────
*.orig
*.rej

# M3：键盘渲染器测试用的布局 fixture，由 tests/unit/test_frontend_js.py 现场导出
tests/frontend/layouts.json
